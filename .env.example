# Supabase Configuration (Required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Optional: Development Mode
VITE_DEV_MODE=false

# Optional: set to "true" only for a standalone single-game deployment
# (e.g. a client's Cycle-Race-only domain) so "/" opens Cycle Race directly
# instead of the multi-game Home dashboard. Leave unset for the normal
# multi-game app.
VITE_STANDALONE_CYCLE_RACE=false

# Optional: exact hostname of the Cycle Race predictions/oversight-only
# domain (e.g. "predictions.example.com"). When the current hostname matches
# this value, the app exposes only the existing admin/marketer prediction
# view - no betting UI, no other games. Leave unset until the client
# supplies the real production hostname; unset means this has no effect.
VITE_CYCLE_RACE_PREDICTIONS_HOST=

# Optional: Analytics
VITE_ANALYTICS_ID=

# Optional: Custom API URL
VITE_API_URL=
